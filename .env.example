# ─── Capstone Decision Module — Environment Configuration ───────────────────
# Copy this file to .env and fill in the values for your local environment.
# .env is listed in .gitignore and must NEVER be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dataset ──────────────────────────────────────────────────────────────────
DATASET_ROOT=HAJJv2.Dataset

# ── Camera video sources ──────────────────────────────────────────────────────
CAMERA_01_SOURCE=HAJJv2.Dataset/Training/Videos/2.mp4
CAMERA_02_SOURCE=HAJJv2.Dataset/Training/Videos/3.mp4

# ── Venue configuration ───────────────────────────────────────────────────────
VENUE_CONFIG=config/venue/circular_venue.yaml

# ── Ingestion settings ────────────────────────────────────────────────────────
INGESTION_TARGET_FPS=5
INGESTION_REAL_TIME_MODE=true
INGESTION_BUFFER_SIZE=30
INGESTION_DROP_POLICY=oldest

# ── CSRNet model ──────────────────────────────────────────────────────────────
CSRNET_ENABLED=true
CSRNET_CHECKPOINT=checkpoints/csrnet_shanghaitech_part_a.pth
CSRNET_RESOLUTION=720x540

# ── ByteTrack (YOLOv8) model ──────────────────────────────────────────────────
# yolov8n.pt | yolov8s.pt | yolov8m.pt | yolov8l.pt | yolov8x.pt
# Weights are downloaded automatically on first run (~88MB for yolov8l.pt)
BYTETRACK_ENABLED=true
BYTETRACK_MODEL=yolov8l.pt
BYTETRACK_CONF=0.3
BYTETRACK_IOU=0.45
BYTETRACK_MOTION_THRESHOLD_PX=2.0

# ── Compute device ────────────────────────────────────────────────────────────
# auto | cpu | cuda
DEVICE=auto
