*.log
logs/

# ─── Environment / secrets ────────────────────────────────────────────────────
# Copy .env.example to .env and fill in your local paths.
# NEVER commit .env — it contains local paths and may contain secrets.
# .env.example IS safe to commit (it contains only placeholder values).
.env
.env.local
.env.*.local
secrets.yaml
secrets.yml

